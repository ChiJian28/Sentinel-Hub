# KeeperHub API Key — get from app.keeperhub.com → Settings → API Keys
KEEPERHUB_API_KEY=kh_your_api_key_here

# Target wallet address to protect
TARGET_WALLET=0x0000000000000000000000000000000000000000

# Chain ID (11155111 = Sepolia testnet, confirmed accepted by organizers)
CHAIN_ID=11155111

# USDC token address on Sepolia (for Aave repay)
# Use the official Aave test USDC on Sepolia
ASSET_TO_REPAY=0x94a9D9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8

# Amount to repay in wei (50 USDC = 50_000_000 at 6 decimals)
REPAY_AMOUNT_WEI=50000000

# Chainlink ETH/USD price feed on Sepolia
ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# Thresholds
HF_CRITICAL_THRESHOLD=1.3
PRICE_BREACH_THRESHOLD_USD=1500

# Monitoring interval in seconds (300 = 5 minutes)
POLL_INTERVAL_SECONDS=300
