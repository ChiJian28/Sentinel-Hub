# Frontend Environment Variables Template
# Copy to .env.local for local frontend development

# FastAPI Backend URL (Local default: http://localhost:8080/api/v1)
# For production deployment (Vercel / Render), set to your deployed backend URL:
# NEXT_PUBLIC_API_BASE=https://your-backend-service.onrender.com/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Valid WalletConnect Cloud Project ID (Get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=c4f79cc821944d9680842e34466bfb00
